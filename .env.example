# AI CCTV .env example.
# Copy this file to .env and edit values for your node.
# Runtime code reads this file instead of OS environment variables.

# Discord alerts.
DISCORD_BOT_TOKEN=replace-me
DISCORD_CHANNEL_ID=123456789012345678

# AI server connection defaults.
AI_CCTV_RTSP_URL=rtsp://127.0.0.1:8554/live
AI_CCTV_MQTT_HOST=
AI_CCTV_MQTT_PORT=1883
AI_CCTV_MQTT_STATUS_TOPIC=ai-cctv/edge-node/status
AI_CCTV_RECOVERY_SERVER_URL=http://127.0.0.1:8002/recover

# AI server monitoring and recovery.
AI_CCTV_MQTT_STATUS_TIMEOUT_SECONDS=5.0
AI_CCTV_MQTT_STATUS_STALE_SECONDS=6.0
AI_CCTV_MQTT_AI_CLIENT_ID=ai-cctv-ai-server-monitor
AI_CCTV_RECOVERY_CAMERA_ID=cam01
AI_CCTV_RECOVERY_DIR=recovered_videos
AI_CCTV_RECOVERY_RECORDING_DIR=original_records
AI_CCTV_RECOVERY_MIN_FAILURE_SECONDS=2.0
AI_CCTV_RECOVERY_TIMEOUT_SECONDS=30.0
AI_CCTV_RECOVERY_SETTLE_SECONDS=2.0
AI_CCTV_RECOVERY_FFMPEG_PATH=ffmpeg

# AI models.
AI_CCTV_YOLO_MODEL_PATH=yolo26s.pt
AI_CCTV_QWEN_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct

# Edge node startup and streaming.
AI_CCTV_EDGE_HOST=
AI_CCTV_EDGE_INTERFACE=
AI_CCTV_RTSP_PORT=8554
AI_CCTV_RTSP_PATH=live
AI_CCTV_BACKUP_DIR=~/backups
AI_CCTV_BACKUP_RECOVERY_HOST=0.0.0.0
AI_CCTV_BACKUP_RECOVERY_PORT=8002
AI_CCTV_PRINT_STARTUP_INFO=1

# Edge support services.
AI_CCTV_EDGE_ENABLE_SUPPORT_SERVICES=1
AI_CCTV_EDGE_ENABLE_MQTT_BROKER=1
AI_CCTV_EDGE_ENABLE_MONITOR=1
AI_CCTV_EDGE_ENABLE_RECOVERY=1

# Edge MQTT.
AI_CCTV_MQTT_BROKER_HOST=0.0.0.0
AI_CCTV_MQTT_STATUS_INTERVAL_SECONDS=2.0
AI_CCTV_MQTT_RETAIN=1
AI_CCTV_MQTT_EDGE_CLIENT_ID=ai-cctv-edge-monitor
AI_CCTV_MONITOR_PROCESS_ID=

# Pseudo edge tester.
AI_CCTV_PSEUDO_EDGE_HOST=127.0.0.1
AI_CCTV_PSEUDO_RTSP_PORT=8554
AI_CCTV_PSEUDO_RTSP_PATH=live
AI_CCTV_PSEUDO_MQTT_PORT=1883
AI_CCTV_PSEUDO_MQTT_TOPIC=ai-cctv/edge-node/status
AI_CCTV_PSEUDO_BACKUP_RECOVERY_PORT=8002
AI_CCTV_PSEUDO_BACKUP_DIR=./pseudo_backups
AI_CCTV_PSEUDO_STATUS_INTERVAL_SECONDS=2.0
